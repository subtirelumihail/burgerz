# Copy to .env.local and adjust as needed.
# Next.js loads .env.local automatically (not committed).

# MSW is enabled by `npm run dev` (no backend required).
# Use `npm run dev:backend` for a real API and set NEXT_PUBLIC_API_URL below.
# NEXT_PUBLIC_API_MOCKING=enabled

# API base URL — required for dev:backend (e.g. http://localhost:8080)
NEXT_PUBLIC_API_URL=

# Public app URL for server-side fetch origin resolution
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev server port (default 3000)
# PORT=3000
