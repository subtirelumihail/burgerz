# Copy to .env.local and adjust as needed.
# Next.js loads .env.local automatically (not committed).

# Enable MSW for local dev without a backend (same as npm run dev:mock)
NEXT_PUBLIC_API_MOCKING=enabled

# API base URL — empty means same-origin paths like /api/burgers
NEXT_PUBLIC_API_URL=

# Public app URL for server-side fetch origin resolution
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev server port (default 3000)
# PORT=3000
